{
  "uid": "goaletto-operations",
  "title": "Goaletto · доставка и worker",
  "description": "Prometheus → VictoriaMetrics. Очереди/мир — текущие DB-снимки, обновление ≤60с. Ошибка/старый снимок скрывает gauges; нет данных не равно нулю. Worker progress изменяется только после завершения итерации или согласованного sender backoff.",
  "schemaVersion": 39,
  "version": 2,
  "tags": [
    "goaletto",
    "operator",
    "victoriametrics"
  ],
  "editable": false,
  "timezone": "utc",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Состояние сбора DB-снимка",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "goaletto-vm"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Нет наблюдений",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "goaletto-vm"
          },
          "expr": "goaletto_db_snapshot_success{job=\"goaletto-worker\"}",
          "legendFormat": "{{route}} {{outcome}}",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ]
    },
