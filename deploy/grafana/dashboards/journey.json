{
  "uid": "goaletto-launch",
  "title": "Goaletto · вход и участие",
  "description": "Текущий снимок фиксированного окна стартов 1/7/30 UTC-дней, рассчитанный существующим SQL. Не произвольный исторический cohort по time picker Grafana. Динамика — история снимков; значения не суммировать и не применять rate/increase. Internal/opt-out исключены из journey. Подробные campaign/locale/variant/tier/set срезы и исторический as-of остаются в операторском SQL/CLI, без идентификаторов в метках Prometheus.",
  "schemaVersion": 39,
  "version": 2,
  "tags": [
    "goaletto",
    "operator",
    "victoriametrics"
  ],
  "editable": false,
  "timezone": "utc",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Покрытие и время наблюдения",
      "description": "Покрытие фиксированного SQL-снимка: available=1 — доступен, limited=1 — окно выходит за начало покрытия. Времена показаны в UTC. Точный исторический as-of доступен через CLI.",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "goaletto-vm"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Нет наблюдений",
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "available_from"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              },
              {
                "id": "displayName",
                "value": "Данные с (UTC)"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "coverage_started_at"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              },
              {
                "id": "displayName",
                "value": "Начало покрытия (UTC)"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "report_at"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              },
              {
                "id": "displayName",
                "value": "Снимок (UTC)"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "goaletto-vm"
          },
          "expr": "sum by(window,measure) (((goaletto_analytics_coverage{job=\"goaletto-worker\",window=\"$window\",measure=~\"available_from|coverage_started_at|report_at\"} * 1000) or goaletto_analytics_coverage{job=\"goaletto-worker\",window=\"$window\",measure=~\"available|limited\"}) and on(job,instance) (goaletto_db_snapshot_success == 1) and on(job,instance) (time()-goaletto_db_snapshot_timestamp_seconds < 120))",
          "legendFormat": "{{measure}}",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "measure",
            "rowField": "window",
            "valueField": "Value",
            "emptyValue": "null"
          }
        }
      ]
    },
