{
  "uid": "goaletto-launch",
  "title": "Goaletto · вход и участие",
  "description": "Текущий снимок фиксированного окна стартов 1/7/30 UTC-дней, рассчитанный существующим SQL. Не произвольный исторический cohort по time picker Grafana. Динамика — история снимков; значения не суммировать и не применять rate/increase. Internal/opt-out исключены из journey. Подробные campaign/locale/variant/tier/set срезы и исторический as-of остаются в операторском SQL/CLI, без идентификаторов в метках Prometheus.",
  "schemaVersion": 39,
  "version": 2,
  "tags": [
    "goaletto",
    "operator",
    "victoriametrics"
  ],
  "editable": false,
  "timezone": "utc",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Покрытие и время наблюдения",
      "description": "Текущий фиксированный SQL-снимок; waiting/unknown и N=0 сохраняются. Timestamp-поля покрытия — Unix seconds. Подробности/исторический as-of доступны через CLI.",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "goaletto-vm"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Нет наблюдений",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "goaletto-vm"
          },
          "expr": "goaletto_analytics_coverage{job=\"goaletto-worker\",window=\"$window\"} and on(job,instance) (goaletto_db_snapshot_success == 1) and on(job,instance) (time()-goaletto_db_snapshot_timestamp_seconds < 120)",
          "legendFormat": "{{measure}}",
          "instant": true,
          "range": false,
          "format": "table"
        }
