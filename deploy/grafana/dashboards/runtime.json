      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "goaletto-vm"
          },
          "expr": "sum by(route) (increase(goaletto_updates_started_total{job=\"goaletto-bot\",kind=\"command\"}[$__range]))",
          "legendFormat": "{{route}} {{outcome}}",
          "instant": true,
          "range": false,
          "format": "table"
