{
  "uid": "goaletto-runtime",
  "title": "Goaletto · бот и команды",
  "description": "Живые process-local попытки. Включают internal и retries; не уникальные пользователи и не продуктовая аналитика. Counters сбрасываются при restart, rate/increase учитывают resets. getUpdates — ожидаемый long polling, отдельно от отправок.",
  "schemaVersion": 39,
  "version": 2,
  "tags": [
    "goaletto",
    "operator",
    "victoriametrics"
  ],
  "editable": false,
  "timezone": "utc",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Scrape bot / worker",
      "description": "",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "goaletto-vm"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Нет наблюдений",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "goaletto-vm"
          },
          "expr": "up{job=~\"goaletto-(bot|worker)\"}",
          "legendFormat": "{{service}}",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 2,
      "title": "Запуски команд за выбранный период",
      "description": "Попытки запуска, включая повторные Update и внутренние аккаунты.",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "goaletto-vm"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "Нет наблюдений",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
