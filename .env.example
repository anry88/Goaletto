# Never put production credentials in version control.
GOALETTO_ENVIRONMENT=development
# Required by goaletto-bot and an explicitly enabled worker sender.
GOALETTO_BOT_TOKEN=
GOALETTO_DATABASE_URL=postgresql+asyncpg://goaletto:goaletto_dev_only@127.0.0.1:5433/goaletto
GOALETTO_LOG_LEVEL=INFO
GOALETTO_WORKER_POLL_SECONDS=1
# Enable only after migrations and the game notification flow are ready.
GOALETTO_OUTBOX_ENABLED=false
# Explicitly enable the game /start (durable entry/claim); default stays preview.
GOALETTO_GAME_ENABLED=false
# Local overlay port (compose.local.yaml); containers use postgres:5432.
GOALETTO_POSTGRES_PORT=5433
# Compose database credentials. Replace both values for HDC.
POSTGRES_DB=goaletto
POSTGRES_USER=goaletto
POSTGRES_PASSWORD=goaletto_dev_only
