# Never put production credentials in version control.
GOALETTO_ENVIRONMENT=development
# Required by goaletto-bot and an explicitly enabled worker sender.
GOALETTO_BOT_TOKEN=
GOALETTO_DATABASE_URL=postgresql+asyncpg://goaletto:goaletto_dev_only@127.0.0.1:5433/goaletto
GOALETTO_LOG_LEVEL=INFO
GOALETTO_WORKER_POLL_SECONDS=1
# Enable only after migrations and the game notification flow are ready.
GOALETTO_OUTBOX_ENABLED=false
# Explicitly enable the game /start (durable entry/claim); default stays preview.
GOALETTO_GAME_ENABLED=false
# Closed test: JSON array of approved numeric Telegram user IDs. Empty = public access.
GOALETTO_ALLOWED_TELEGRAM_IDS=[]
# Confirmed owner/test accounts excluded from product analytics; independent of access.
GOALETTO_INTERNAL_TELEGRAM_IDS=[]
# Local overlay port (compose.local.yaml); containers use postgres:5432.
GOALETTO_POSTGRES_PORT=5433
# Compose database credentials. Replace both values for HDC.
POSTGRES_DB=goaletto
POSTGRES_USER=goaletto
POSTGRES_PASSWORD=goaletto_dev_only

# Internal-only automatic feedback, default off; requires feedback + retention.
GOALETTO_FEEDBACK_AUTOMATIC_ENABLED=false

# Private Prometheus endpoint; no host port is published by Compose.
GOALETTO_METRICS_ENABLED=false
GOALETTO_METRICS_HOST=127.0.0.1
GOALETTO_METRICS_PORT=9109
GOALETTO_METRICS_SNAPSHOT_SECONDS=60

# Stars invoices and manual payment support; set admin chat in a host-only file.
# Requires GOALETTO_OUTBOX_ENABLED=true for receipts and approved refunds.
GOALETTO_PAYMENTS_ENABLED=true
GOALETTO_PAYMENTS_ADMIN_CHAT_ID=0
